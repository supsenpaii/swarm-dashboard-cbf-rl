<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="sparrow_gimbal">
    <include merge="true">
      <uri>model://sparrow</uri>
    </include>
    <!-- Sparrow P joint in the GZ model frame: CAD (0,-.11,.006908) minus
         CAD CG (0,.03061,.07075), then Rz(pi/2); +X is PX4 forward.
         sparrow_base places base_link at model z=0.10, so the include pose
         must add that same 0.10 m to keep P at z=-0.063842 from base_link. -->
    <include merge="true">
      <uri>model://sparrow_gimbal_core</uri>
      <pose>0.14061 0 0.036158 0 0 0</pose>
    </include>
    <joint name="GimbalAttachJoint" type="fixed">
      <parent>base_link</parent>
      <child>cgo3_mount_link</child>
    </joint>

    <!-- Dashboard payload retained from x500_custom.  The explicit shared
         topic lets one subscriber receive both instances and split scans by
         the message frame, matching the existing dashboard contract. -->
    <link name="front_lidar_link">
      <pose relative_to="base_link">0.18 0 0.05 0 0 0</pose>
      <inertial>
        <mass>0.10</mass>
        <inertia>
          <ixx>0.00008</ixx>
          <iyy>0.00008</iyy>
          <izz>0.00010</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name="front_lidar_visual">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.040</length></cylinder>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <collision name="front_lidar_collision">
        <geometry>
          <cylinder><radius>0.035</radius><length>0.040</length></cylinder>
        </geometry>
      </collision>
      <sensor name="front_lidar" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <topic>/sparrow_gimbal/front_lidar</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.15</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>
    <joint name="front_lidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_lidar_link</child>
    </joint>
  </model>
</sdf>
