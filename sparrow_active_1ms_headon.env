# Sparrow ACTIVE at 1 m/s, head-on -- the first flight in which the CBF-RL
# policy holds transmit authority instead of watching.
#
# Why this rung exists
# --------------------
# The same geometry flown in shadow (sparrow_shadow_1ms_headon.env) aborted on
# cbf_separation_violated:-0.10. That was not a policy failure: in shadow the
# policy's output is discarded and the coordinator is reset every frame, so the
# only thing between two vehicles driving through each other was the CBF gate.
# A CBF is a shield -- it brakes along the line of approach. Nothing in shadow
# mode was steering AROUND the peer. This profile turns on the two layers that
# actually resolve a head-on: the RL policy's lateral pass bias and the
# ConflictCoordinator's one-sided yield.
#
# SWARM_CBF_RL_ACTIVE_ACK is the project's human-in-the-loop interlock; it is
# set here deliberately, for SITL, with the operator's go-ahead.
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=false

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=60,0,0,0,0,0
SWARM_FORMATION_SLOT_UAV_02_ENU_M=60,0,0

# Matches the Sparrow airframe's own MPC_ACC_HOR_MAX. The 0.5 m/s2 default
# cannot reach 15 m/s on a 240 m square at all -- the straights are shorter
# than the accelerate-and-brake distance -- so leaving it there measures the
# default, not the aircraft.
SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0
# Measured horizontal response of this airframe. Without it the corner
# budget is spent entirely on geometry and the aircraft overruns it:
# 3.49 m of cross-track against a 1 m tolerance on a 240 m square.
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86

# 100 ms is contractual for the sparrow profile, not a tuning knob:
# _validate_active_contract refuses transmit authority if it disagrees.
SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10.0
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-500,-500,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=500,500,200

SWARM_CBF_RL_MODE=active
SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_10ms_v1.json
SWARM_CBF_RL_MODEL_SHA256=bb61f15e6832a0afad8ee6ded649c3210fbdf521a20a2056742c4c9ef509e1ef
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_sparrow_active_1ms_headon.jsonl

# Reciprocal legs down one 60 m corridor: the pair must swap ends, so the
# conflict cannot be dodged by geometry -- somebody has to give way.
SWARM_TRAJECTORY_UAV_01_KIND=linear
SWARM_TRAJECTORY_UAV_01_START_ENU_M=0,0,10
SWARM_TRAJECTORY_UAV_01_END_ENU_M=60,0,10
SWARM_TRAJECTORY_UAV_01_SPEED_M_S=1.0
SWARM_TRAJECTORY_UAV_02_KIND=linear
SWARM_TRAJECTORY_UAV_02_START_ENU_M=60,0,10
SWARM_TRAJECTORY_UAV_02_END_ENU_M=0,0,10
SWARM_TRAJECTORY_UAV_02_SPEED_M_S=1.0
