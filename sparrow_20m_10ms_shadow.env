# Certified offline Sparrow CBF-RL profile. Shadow has no PX4 transmit authority.
SWARM_OFFBOARD_AUTHORITY=disabled
SWARM_MISSION_RUNTIME_ENABLED=false

# Start outside the certified 20 m boundary for ordinary dashboard bring-up.
SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=0,30,0,0,0,0
SWARM_FORMATION_SLOT_UAV_02_ENU_M=0,30,0

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10.0
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-500,-500,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=500,500,200

SWARM_CBF_RL_MODE=shadow
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_10ms_v1.json
