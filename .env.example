# External workspaces
SWARM_TRACKING_PACKAGE_ROOT=/home/user/ws_px4/src/lfc_gimbal_gazebo
SWARM_ROS_SETUP=/home/user/ws_px4/install/setup.bash
PX4_AUTOPILOT_ROOT=/home/user/PX4-Autopilot
SWARM_GZ_MODEL_ROOT=${script_dir}/models/models
SWARM_PX4_SYS_AUTOSTART=4020
SWARM_PX4_SIM_MODEL=gz_sparrow_gimbal
SWARM_GAZEBO_MODEL_UAV_01=sparrow_gimbal_0
SWARM_GAZEBO_MODEL_UAV_02=sparrow_gimbal_1
SWARM_GAZEBO_LIDAR_TOPIC=/sparrow_gimbal/front_lidar
SWARM_GAZEBO_CAMERA_EXPECTED_RATE_HZ=30
SWARM_GAZEBO_CAMERA_IMU_EXPECTED_RATE_HZ=250

# Common WGS-84 reference for SwarmState ENU coordinates. Set all three for
# swarm formation/CBF observability; no PX4 local-NED origin is used instead.
#
# This MUST match the origin of the world the vehicles actually spawn in. A
# mismatch does not fail loudly: positions stay finite and the API keeps
# serving, but every ENU coordinate is offset by the distance between the two
# origins, so separations and formation errors are silently wrong. The values
# below are the PX4 default SITL world (Zurich). Re-derive them for any other
# world from its <spherical_coordinates> block rather than copying blindly:
#
#   grep -A6 spherical_coordinates \
#     "$PX4_AUTOPILOT_ROOT/Tools/simulation/gz/worlds/default.sdf"
#
SWARM_ENU_ORIGIN_LAT_DEG=47.397971057728974
SWARM_ENU_ORIGIN_LON_DEG=8.546163739800146
SWARM_ENU_ORIGIN_ALT_MSL_M=0.0
SWARM_STATE_MAX_MESSAGE_AGE_MS=500

# Direct companion-to-companion UDP peer state. It remains off until each
# companion has an explicit unicast endpoint for the other companion.
SWARM_PEER_STATE_ENABLED=false
SWARM_PEER_STATE_RATE_HZ=20
SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_PEER_STATE_BIND_HOST=0.0.0.0
SWARM_PEER_STATE_BIND_PORT=14670
# UAV-01: other companion's IP; UAV-02: reverse the mapping.
SWARM_PEER_STATE_ENDPOINTS=192.168.1.102:14670
# In SITL every companion shares one host, so the shared bind port above cannot
# work for more than one drone. These per-drone overrides give each its own
# socket; leave them unset on real hardware, where one port per host is right.
#SWARM_PEER_STATE_BIND_PORT_UAV_01=14670
#SWARM_PEER_STATE_ENDPOINTS_UAV_01=127.0.0.1:14671
#SWARM_PEER_STATE_BIND_PORT_UAV_02=14671
#SWARM_PEER_STATE_ENDPOINTS_UAV_02=127.0.0.1:14670

# Companion-local nominal controller and CBF filter, running inside the bridge
# and fed only by the peer-to-peer link above, so that losing the server does
# not remove collision avoidance. Shadow only: never routed to PX4. Requires
# SWARM_PEER_STATE_ENABLED, since without neighbours there is nothing to filter.
SWARM_COMPANION_SAFETY_ENABLED=false
# Optional JSONL trace, needed to observe the companion while the server is down.
#SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety/trace.jsonl

# Dashboard-installed missions are default-off. Their velocity slew limit is
# intentionally separate from SWARM_TRAJECTORY_* system-identification steps.
SWARM_MISSION_RUNTIME_ENABLED=false
# Raised explicitly, which is what SPEED_FRACTION_OF_CBF_LIMIT exists to
# require: without this the drawn-mission slider stops at half the CBF
# ceiling. Earned on 2026-08-17 -- sparrow_mission_crossing.env flew the
# head_on_swap and opposite_orbit crossing scenarios at this speed on the
# drawn-mission path and both passed.
#
# Not a blanket clearance for the path. diagonal_cross, which commands both
# vehicles onto one shared vertex, is still unflyable at this speed and the
# barrier reports cbf_invalid_or_infeasible rather than accepting it. Watch
# CBF can thiệp in the telemetry panel: sustained intervention means the
# coordinator is not resolving the encounter and the barrier is carrying it.
SWARM_MISSION_MAXIMUM_VELOCITY_M_S=10

SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
# Sparrow's measured first-order response, used by the corner braking law.
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0

# How long the companion safety loop above may go without producing a new
# evaluation before main()'s own watchdog (a separate thread, so it keeps
# working even if a worker's loop actually freezes) reports the worker
# stalled: a log line plus a retained MQTT message on
# swarm/{drone_id}/system/worker_liveness. See worker_liveness_watchdog.py.
SWARM_WORKER_LIVENESS_STALL_S=1.5

# Deterministic formation, shadow-only. The controller produces no PX4/MQTT
# command; it exposes bounded ENU nominal velocities at /api/drones.
SWARM_FORMATION_SHADOW_ENABLED=false
SWARM_FORMATION_LEADER_ID=UAV-01
SWARM_FORMATION_SLOT_UAV_02_ENU_M=-40,0,0
SWARM_FORMATION_POSITION_GAIN_S_INV=0.6
SWARM_FORMATION_MAXIMUM_VELOCITY_M_S=10
SWARM_FORMATION_ARRIVAL_RADIUS_M=0.25

# Per-drone trajectory tracking, companion-side (companion_safety.py). Opt-in
# and unset by default: when SWARM_TRAJECTORY_<DRONE_ID>_KIND is unset, that
# drone keeps its existing formation/altitude-hold nominal exactly as before
# this existed. Setting it REPLACES that nominal entirely for this drone --
# formation slot or not -- with p_ref(t)/v_ref(t) tracking, still filtered by
# the same local CBF + EmergencySupervisor chain. See trajectory_controller.py.
#
# KIND=linear:   constant-velocity straight line, holds at END once reached.
#SWARM_TRAJECTORY_UAV_01_KIND=linear
#SWARM_TRAJECTORY_UAV_01_START_ENU_M=0,0,10
#SWARM_TRAJECTORY_UAV_01_END_ENU_M=20,0,10
#SWARM_TRAJECTORY_UAV_01_SPEED_M_S=1.0
#
# Pre-flight refusal limit for two_uav_trajectory_flight.py: how far a
# vehicle's real shared-ENU position may sit from its trajectory's p_ref(0)
# before the flight is refused, checked while both still hover in POSCTL and
# before either enters OFFBOARD. An engineering guard for catching a WRONG
# FRAME (or a stale trajectory config), not a tuning knob -- see the rationale
# and the measured numbers behind the 1.5 m default in that driver.
#SWARM_TRAJECTORY_INITIAL_ERROR_MAX_M=1.5
#
# KIND=circular: constant-angular-rate orbit, never finishes (a loiter).
#SWARM_TRAJECTORY_UAV_02_KIND=circular
#SWARM_TRAJECTORY_UAV_02_CENTER_ENU_M=0,0,10
#SWARM_TRAJECTORY_UAV_02_RADIUS_M=5.0
#SWARM_TRAJECTORY_UAV_02_ANGULAR_RATE_RAD_S=0.2
#SWARM_TRAJECTORY_UAV_02_START_ANGLE_RAD=0.0

# Target-relative dynamic formation (architecture doc §17), independent of
# the leader-relative formation above. Shadow-only, server-side (target
# fusion is a server responsibility per §3.1, unlike CBF).
#
# STAND_IN_DRONE_ID names an ALLOWED_DRONES member whose own real ENU state
# is used as the "target" -- a validation stand-in for exercising the
# dynamic-slot math against real, live numbers without activating the
# camera/tracker pipeline. It is NOT vision integration. Leave unset to keep
# this disabled (the default; an empty value fails closed with
# target_formation.config_error at /api/drones).
SWARM_TARGET_FORMATION_SHADOW_ENABLED=false
SWARM_TARGET_FORMATION_STAND_IN_DRONE_ID=
SWARM_TARGET_FORMATION_SLOT_UAV_02_ENU_M=-5,0,2

# Single-writer interlock for the PX4 OFFBOARD path. Exactly one writer may
# ever be authorized: disabled | legacy_tracking | companion_safety.
#
# Fails closed to "disabled" (no writer authorized) when the value is unset,
# unknown, set to legacy_tracking while every legacy OFFBOARD flag is off, or
# set to companion_safety while ANY of these is on:
#   SWARM_TRACKING_OFFBOARD_ENABLED, SWARM_ALLOW_RAW_ATTITUDE_OFFBOARD,
#   SWARM_LEGACY_AUTOMATION_ENABLED,
#   SWARM_SAFE_NATIVE_FOLLOW_MODE_REQUEST_ENABLED
# The legacy writer consults this immediately before every transmit, so the
# interlock cannot be bypassed by a stale cached value.
SWARM_OFFBOARD_AUTHORITY=disabled

# CBF gate after formation. Shadow-only: it neither arms nor changes mode and
# does not publish to PX4 until SITL safety/fault-injection gates pass.
SWARM_CBF_SHADOW_ENABLED=false
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
# NOT a "safer is bigger" knob -- measured unsafe at higher closing speeds,
# where a larger buffer raises relative speed, which raises required_margin,
# in a loop. Zero is the certified Sparrow value. See CbfConfig's own comment.
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
# 0.86 s is Sparrow's measured command response. 0.65 s was the x500 value
# and stayed here long after the default airframe became gz_sparrow_gimbal:
# the barrier sized its latency term for a vehicle that is not the one
# flying, and understating latency understates required_margin.
SWARM_CBF_COMMAND_LATENCY_S=0.86
# The pair's guaranteed relative deceleration, so two vehicles at 4 m/s^2
# give 8. Zero keeps the first-order contract, which is only adequate at the
# low speeds this file used to describe.
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
# PX4 does not fly exactly what it is commanded; this is the reserve for it.
SWARM_CBF_TRACKING_RESERVE_M=2.0
# Covariance publication, margin multiplier, and missing-data policy are
# independent. Defaults preserve historical behavior until explicitly tuned.
SWARM_CBF_UNCERTAINTY_SOURCE=off
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
# Room for a 20 m separation at 10 m/s: the certified Sparrow scenarios run
# 180-540 m legs, which do not fit in the old +/-100 m box.
SWARM_CBF_GEOFENCE_MIN_ENU_M=-600,-600,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=600,600,200

# Authenticated CBF-RL runtime. `shadow` never has authority. `active` is
# accepted only with the exact ACK below, the frozen model SHA, peer age 100 ms,
# and the selected vehicle CBF contract; any mismatch falls back to deterministic.
# Roll back by setting MODE=shadow or off and restarting the stack.
SWARM_CBF_RL_MODE=off
SWARM_CBF_RL_MODEL=cbf_rl_policy_v1.json
#SWARM_CBF_RL_MODEL_SHA256=<sha256 of the complete model artifact>
#SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1

# Current tracking/follow defaults
SWARM_TRACKING_BACKEND=hybrid
SWARM_OPENCV_TRACKER=KCF
# LightFC-derived robustness gates used by the default hybrid tracker.
SWARM_REID_AFTER=5
SWARM_REID_INTERVAL=2
SWARM_REID_CONFIRM=2
SWARM_REID_TRACK_THRESHOLD=0.62
SWARM_REID_THRESHOLD=0.48
SWARM_REID_SCORE_THRESHOLD=0.58
SWARM_REID_PSR_THRESHOLD=3.8
SWARM_REID_AMBIGUITY_RATIO=0.82
SWARM_REID_DIRECTION_WEIGHT=0.08
SWARM_REID_LOCAL_SEARCH_FACTOR=6.0
SWARM_REID_FULL_FRAME_AFTER=16
SWARM_MEMORY_UPDATE_THRESHOLD=0.72
SWARM_TRACKING_MAX_SCALE_CHANGE=1.8
SWARM_TRACKING_MAX_CENTER_JUMP_RATIO=2.5
# Local scale search around the KCF/Kalman centre (never a full-frame scan).
SWARM_TRACKING_SCALE_REFINER_ENABLED=true
SWARM_TRACKING_SCALE_UPDATE_EVERY_N=3
SWARM_TRACKING_SCALE_CANDIDATES=0.92,1.0,1.08
SWARM_TRACKING_SCALE_MIN_PSR=3.5
SWARM_TRACKING_SCALE_MIN_SCORE=0.68
SWARM_TRACKING_SCALE_MAX_STEP_RATIO=0.18
SWARM_TRACKING_SCALE_KCF_REINIT_RATIO=0.05
SWARM_TRACKING_BBOX_CENTER_ALPHA=0.55
SWARM_TRACKING_BBOX_SIZE_ALPHA=0.20
SWARM_TRACKING_BBOX_MAX_SIZE_ALPHA=0.48
SWARM_TRACKING_OFFBOARD_ENABLED=false
# Pinned explicitly: one of the legacy OFFBOARD writer flags checked by the
# single-writer interlock (SWARM_OFFBOARD_AUTHORITY above).
SWARM_ALLOW_RAW_ATTITUDE_OFFBOARD=false
SWARM_TRACKING_OFFBOARD_MAX_FORWARD_M_S=3.0
SWARM_TRACKING_OFFBOARD_MAX_YAW_RATE_DEG_S=25
SWARM_TRACKING_OFFBOARD_YAW_SLEW_DEG_S2=80
SWARM_TRACKING_GIMBAL_KP=6.0
SWARM_TRACKING_GIMBAL_KI=0.0
SWARM_TRACKING_GIMBAL_KD=0.05
SWARM_TRACKING_GIMBAL_EMA_ALPHA=0.75
SWARM_TRACKING_GIMBAL_DEADBAND_DEG=0.35
SWARM_TRACKING_GIMBAL_OMEGA_MAX_DEG=180
SWARM_TRACKING_GIMBAL_SLEW_MAX_DEG=900
SWARM_TRACKING_GIMBAL_MAX_PITCH_RATE_DEG_S=180
SWARM_TRACKING_GIMBAL_MAX_YAW_RATE_DEG_S=180
SWARM_TRACKING_GIMBAL_MAX_ACCEL_DEG_S2=900
SWARM_TRACKING_GIMBAL_MAX_BRAKE_ACCEL_DEG_S2=1400
SWARM_TRACKING_GIMBAL_COMMAND_STALE_RESET_S=0.25
SWARM_TRACKING_GIMBAL_COMMAND_RATE_HZ=40
SWARM_TRACKING_GIMBAL_TARGET_STALE_S=0.20
SWARM_TRACKING_GIMBAL_MAX_COMMAND_LEAD_DEG=5
SWARM_TRACKING_GIMBAL_PREDICTION_LATENCY_S=0.08
SWARM_TRACKING_GIMBAL_MAX_PREDICTION_HORIZON_S=0.12
SWARM_TRACKING_GIMBAL_YAW_INVERT=false
# Gazebo Sparrow: negative pitch moves a below-center target upward.
SWARM_TRACKING_GIMBAL_PITCH_INVERT=false
SWARM_TRACKING_GIMBAL_YAW_LIMIT_DEG=10
SWARM_TRACKING_GIMBAL_PITCH_MIN_DEG=-45
SWARM_TRACKING_GIMBAL_PITCH_MAX_DEG=45
SWARM_TRACKING_GIMBAL_YAW_HOME_EXIT_DEG=1.0
SWARM_TRACKING_GIMBAL_BBOX_CENTER_EXIT_DEG=1.0
# Enable the slow independent body-yaw recenter loop. It remains blocked in
# HOLD/DEGRADED and whenever tracking, pose, gimbal feedback, or score is stale.
SWARM_TRACKING_BODY_YAW_ENABLED=false
SWARM_TRACKING_FOLLOW_ENABLED=false
SWARM_TRACKING_FOLLOW_MIN_DISTANCE_M=8.0
SWARM_TRACKING_FOLLOW_MAX_DISTANCE_M=12.0
SWARM_TRACKING_FOLLOW_BRAKE_M_S2=1.5
SWARM_VISUAL_FOLLOW_TARGET_ENABLED=true
SWARM_NATIVE_FOLLOW_TARGET_ENABLED=false
SWARM_APPARENT_SIZE_FOLLOW_ENABLED=false
SWARM_VISUAL_FOLLOW_AUTO_START=false
# P1A containment: target beacons may be evaluated in shadow, but PX4 Follow
# entry and the optional centered MANUAL_CONTROL heartbeat remain disabled.
SWARM_SAFE_NATIVE_FOLLOW_MODE_REQUEST_ENABLED=false
# Separately named regression-only authority. It cannot coexist with safe
# native Follow entry and remains off unless a dedicated legacy test is approved.
SWARM_LEGACY_AUTOMATION_ENABLED=false
# Follow remains disabled until this continuous pointing-stable interval passes.
SWARM_VISUAL_FOLLOW_CENTER_HOLD_S=0.60
SWARM_VISUAL_FOLLOW_MIN_STABLE_FRAMES=12
SWARM_FOLLOW_SELECTION_POSE_MAX_AGE_MS=200
SWARM_FOLLOW_SELECTION_GIMBAL_MAX_AGE_MS=120
# Armed/failsafe/nav status arrives at 2 Hz in the current ROS bridge. The
# separate MAVLink pose stream remains guarded at 200 ms and runs at 20 Hz.
SWARM_TRACKING_STATUS_MAX_AGE_MS=750
# PX4 FLW_TGT_ALT_M=0 holds this home-relative altitude. Follow is blocked
# below the limit; it is never silently clamped upward.
SWARM_FOLLOW_MIN_ALTITUDE_M=8.0
SWARM_FOLLOW_PRESTREAM_MIN_MESSAGES=5
SWARM_FOLLOW_MODE_CONFIRM_TIMEOUT_S=6.0
SWARM_FOLLOW_RELATIVE_ANGLE_DEG=180
SWARM_VISUAL_FOLLOW_YAW_RATE_DEG_S=120
SWARM_VISUAL_FOLLOW_YAW_ACCEL_DEG_S2=240
SWARM_TRACKING_BODY_ATTITUDE_ENABLED=false

# Slow body-yaw outer loop. The fast gimbal loop remains the bbox authority.
SWARM_BODY_RECENTER_ENTER_DEG=3.75
SWARM_BODY_RECENTER_EXIT_DEG=1.25
SWARM_BODY_RECENTER_ENTER_HOLD_S=0.12
SWARM_BODY_RECENTER_FILTER_TAU_S=0.12
SWARM_BODY_RECENTER_YAW_KP=1.6
SWARM_BODY_RECENTER_BBOX_FEEDFORWARD_GAIN=0.20
SWARM_BODY_RECENTER_MAX_YAW_RATE_DEG_S=20.0
SWARM_BODY_RECENTER_RATE_SLEW_DEG_S2=120.0
SWARM_BODY_RECENTER_YAW_INVERT=false

# QGroundControl MAVLink proxy
SWARM_QGC_MAVLINK_PROXY_ENABLED=true
SWARM_QGC_MAVLINK_HOST=127.0.0.1
SWARM_QGC_MAVLINK_PORT=14550
SWARM_QGC_PROXY_BASE_PORT=14650

# RGB camera geometry. FX/FY are derived from this geometry unless explicitly
# overridden; keep these values consistent with the Gazebo camera sensor.
SWARM_CAMERA_WIDTH=640
SWARM_CAMERA_HEIGHT=360
SWARM_CAMERA_HORIZONTAL_FOV_RAD=2.0
# Camera optical-center lever arm from vehicle origin, in body FRD.
SWARM_CAMERA_OFFSET_BODY_FORWARD_M=0.14061
SWARM_CAMERA_OFFSET_BODY_RIGHT_M=0.0
SWARM_CAMERA_OFFSET_BODY_DOWN_M=0.063842
# Tracking keeps the full source frame; only browser previews resize.
SWARM_CAMERA_PREVIEW_MAX_WIDTH=640
SWARM_TRACKING_PREVIEW_MAX_WIDTH=640

# Bearing-only multi-view target estimator. Metric range becomes valid only
# after enough translation baseline and a well-conditioned ray intersection.
# It remains the fallback when the asynchronous metric pipeline below is off.
#
# MiDaS + M52 + EKF metric target fusion. Keep disabled until both local paths
# are installed; model loading never downloads weights during a flight.
SWARM_METRIC_TARGET_FUSION_ENABLED=true
SWARM_METRIC_TARGET_DEPTH_BACKEND=midas_small
SWARM_MIDAS_REPOSITORY=${script_dir}/models/MiDaS
SWARM_MIDAS_CHECKPOINT=${script_dir}/models/midas_v21_small_256.pt
SWARM_MIDAS_MODEL=MiDaS_small
SWARM_MIDAS_DEVICE=auto
SWARM_MIDAS_INPUT_SIZE=256
SWARM_METRIC_TARGET_DEPTH_RATE_HZ=7.5
SWARM_METRIC_TARGET_MAX_DEPTH_AGE_S=0.75
SWARM_METRIC_TARGET_DROPOUT_TIMEOUT_S=1.50
SWARM_METRIC_TARGET_BEARING_NOISE_PX=1.5
SWARM_METRIC_CALIBRATION_CACHE_TTL_S=2.50
SWARM_METRIC_CALIBRATION_SCALE_DRIFT_FRACTION_PER_S=0.08
SWARM_METRIC_CALIBRATION_OFFSET_DRIFT_M_INV_PER_S=0.003
# Strong pre-EKF bearing/range filter. The bbox/gimbal path remains fast;
# only the geolocation sent to PX4 is strongly smoothed.
SWARM_BR_FILTER_BEARING_WINDOW=7
SWARM_BR_FILTER_BEARING_TAU_S=0.35
SWARM_BR_FILTER_MAX_BEARING_RATE_DEG_S=60
SWARM_BR_FILTER_BEARING_OUTLIER_DEG=8
SWARM_BR_FILTER_RANGE_WINDOW=9
SWARM_BR_FILTER_RANGE_MIN_SAMPLES=5
SWARM_BR_FILTER_RANGE_TAU_S=1.20
SWARM_BR_FILTER_RANGE_HAMPEL_SIGMA=4.0
SWARM_BR_FILTER_RANGE_ABS_GATE_M=1.0
SWARM_BR_FILTER_RANGE_REL_GATE=0.08
SWARM_BR_FILTER_MAX_RANGE_RATE_M_S=4.0
SWARM_BR_FILTER_MAX_RANGE_ACCEL_M_S2=6.0
SWARM_BR_FILTER_MIN_RANGE_M=1.0
SWARM_BR_FILTER_MAX_RANGE_M=80.0
SWARM_BR_FILTER_MAX_MEASUREMENT_STD_M=3.0
SWARM_BR_FILTER_MAX_MEASUREMENT_REL_STD=0.20
# NED down coordinate of the local ground plane. Zero is the PX4 home plane.
SWARM_M52_GROUND_DOWN_M=0.0
# Enable only for targets known to remain in contact with the ground.
SWARM_M52_GROUND_TARGET_MODE=false
# Deterministic pre-filter applicability containment. The active defaults match
# the currently locked front-facing evidence; widen only after new holdouts.
SWARM_RANGE_APPLICABILITY_MODE=active
SWARM_RANGE_APPLICABILITY_MAX_ABS_IMAGE_RAY_X=0.45
SWARM_RANGE_APPLICABILITY_MAX_ABS_IMAGE_RAY_Y=0.85
SWARM_RANGE_APPLICABILITY_MAX_CALIBRATION_CONDITION=100000
SWARM_RANGE_APPLICABILITY_MAX_CALIBRATION_RESIDUAL_M_INV=0.025
SWARM_RANGE_APPLICABILITY_MIN_CALIBRATION_INLIER_FRACTION=0.45
SWARM_RANGE_APPLICABILITY_MIN_ANCHOR_SPATIAL_COVERAGE=0.25
SWARM_RANGE_APPLICABILITY_MAX_TARGET_EXTRAPOLATION_IQR=0.50
SWARM_RANGE_APPLICABILITY_MAX_RANGE_RELATIVE_STD=0.30
# Residual correction remains disabled until a v2 bundle passes promotion.
SWARM_RANGE_RESIDUAL_MODE=off
# SWARM_RANGE_RESIDUAL_BUNDLE=/absolute/path/to/v2_bundle

# Range-residual dataset labels default to synchronized Gazebo truth. For real
# collection, set the source below to rtk_fixed_camera_to_target_center and
# explicitly calibrate both antenna-to-center vectors in each vehicle's body
# FRD frame. RTK float/GPS-only fixes, labels older than 100 ms, combined
# uncertainty above 0.20 m, or missing lever-arm calibration fail closed.
SWARM_RANGE_DATASET_GROUND_TRUTH_SOURCE=gazebo_camera_to_target_center
# SWARM_RANGE_RTK_CAMERA_ANTENNA_TO_CENTER_BODY_FRD_M=0.0,0.0,0.0
# SWARM_RANGE_RTK_TARGET_ANTENNA_TO_CENTER_BODY_FRD_M=0.0,0.0,0.0
# SWARM_RANGE_RTK_LEVER_ARM_UNCERTAINTY_M=0.02
SWARM_RANGE_RTK_MAX_TIME_OFFSET_MS=100
SWARM_RANGE_RTK_MAX_UNCERTAINTY_M=0.20

SWARM_BEARING_MIN_OBSERVATIONS=6
# Retain about 3 s at 30 FPS so a physically ramped 0.4–0.5 m/s bootstrap can
# reach the 0.50 m baseline gate without discarding its earliest RGB bearings.
SWARM_BEARING_MAX_OBSERVATIONS=90
SWARM_BEARING_WINDOW_S=5.0
SWARM_BEARING_MIN_TRACKING_SCORE=0.70
SWARM_BEARING_MAX_POSE_AGE_S=0.15
SWARM_BEARING_MAX_GIMBAL_AGE_S=0.12
SWARM_BEARING_MIN_BASELINE_M=0.50
SWARM_BEARING_MIN_INTERSECTION_DEG=3.0
# Safety gate: do not relax this merely to make a SITL run pass. Diagnose
# frame/pose/gimbal timestamps, target motion and bbox bias instead.
SWARM_BEARING_MAX_REPROJECTION_PX=3.0
SWARM_BEARING_MIN_RANGE_M=1.0
SWARM_BEARING_MAX_RANGE_M=80.0
SWARM_BEARING_MAX_RANGE_STD_M=1.0
SWARM_BEARING_MAX_RANGE_REL_STD=0.15
SWARM_BEARING_STALE_TIMEOUT_S=0.50
SWARM_BEARING_MAX_CONDITION=1000000
SWARM_BEARING_NOISE_PX=1.5
SWARM_BEARING_ACCEL_NOISE_M_S2=1.5
SWARM_BEARING_INNOVATION_GATE_SIGMA=4.0
# User-authorized RGB bootstrap. Direction is local-NED perpendicular to the
# saved selection bearing; UI confirmation is still mandatory each session.
SWARM_BEARING_BOOTSTRAP_LATERAL_DISTANCE_M=0.75
SWARM_BEARING_BOOTSTRAP_LATERAL_SPEED_M_S=0.40
SWARM_BEARING_BOOTSTRAP_TIMEOUT_S=4.0
SWARM_RGB_BOOTSTRAP_MAX_BASELINE_M=1.25
SWARM_RGB_BOOTSTRAP_DIRECTION=right
