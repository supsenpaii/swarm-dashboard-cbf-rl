# Sparrow crossing missions on the WEB mission path, 10 m/s envelope.
#
# Everything certified so far went through the trajectory path
# (SWARM_TRAJECTORY_*, mission runtime OFF). This profile certifies the other
# one: the path a drawn polygon takes from the dashboard, over the websocket,
# through mission_plan's validators and into the same coordinator and barrier.
# Same avoidance code, a control path that had never flown above 1 m/s.
#
# Geometry is not written here. two_uav_mission_circle_flight.py draws its
# five scenarios against two spawns 5.39 m apart and then fits that picture
# onto wherever the vehicles actually are, so the poses below set the scale:
# 200 m apart gives 180-388 m legs, comparable to the corridor's 300 m, and
# every scenario stays inside the geofence (opposite_orbit reaches 520 m N).
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=true

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=-186,74,0,0,0,0
SWARM_PX4_MPC_XY_VEL_MAX=10.0
SWARM_FORMATION_MAXIMUM_VELOCITY_M_S=10
SWARM_FORMATION_SLOT_UAV_02_ENU_M=-186,74,0

# The dashboard normally holds the mission at half the CBF ceiling
# (SPEED_FRACTION_OF_CBF_LIMIT). This is the explicit raise that clamp exists
# to require, and the whole point of the profile: fly the mission path at the
# rung's own speed so the ceiling is measured rather than assumed.
SWARM_MISSION_MAXIMUM_VELOCITY_M_S=10
SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-600,-600,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=600,600,200

SWARM_CBF_RL_MODE=active
SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_10ms_v1.json
SWARM_CBF_RL_MODEL_SHA256=bb61f15e6832a0afad8ee6ded649c3210fbdf521a20a2056742c4c9ef509e1ef
# Per scenario, not one shared file: the first run of the four overwrote
# diagonal_cross's evidence with the last scenario's, and diagnosing its
# cbf_invalid_or_infeasible then needed the flight repeated. The runner
# exports SWARM_MISSION_SCENARIO before sourcing this.
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_mission_${SWARM_MISSION_SCENARIO:-unset}.jsonl

SWARM_FIRST_FLIGHT_MAX_DURATION_S=420
