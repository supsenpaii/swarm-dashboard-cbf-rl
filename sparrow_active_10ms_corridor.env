# Sparrow ACTIVE corridor swap at 10 m/s -- rung 10 of the flight ladder.
#
# One corridor, two vehicles at opposite ends, both required to reach the
# other end. The conflict cannot be dodged by geometry: somebody has to give
# way, and unlike the safety matrix's 160 m of open runway the corridor is
# only 300 m, roughly 15x the separation the barrier demands. That is
# the geometry a drawn mission actually produces when two aircraft are sent
# down the same lane in opposite directions.
#
# Corridor length is 30 s of closing time at the rung ceiling, so every rung
# poses the same question in time rather than a progressively easier one in
# distance.
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=false

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=300,0,0,0,0,0
# The entry controller and the tracker share this ceiling; below the
# trajectory speed the path can never be entered at all.
SWARM_FORMATION_MAXIMUM_VELOCITY_M_S=10
SWARM_FORMATION_SLOT_UAV_02_ENU_M=300,0,0

# Matches the Sparrow airframe's own MPC_ACC_HOR_MAX. The 0.5 m/s2
# default cannot reach 15 m/s on a 240 m square at all -- the straights
# are shorter than the accelerate-and-brake distance -- so leaving it
# there measures the default, not the aircraft.
SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0
# Measured horizontal response of this airframe. Without it the corner
# budget is spent entirely on geometry and the aircraft overruns it:
# 3.49 m of cross-track against a 1 m tolerance on a 240 m square.
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-600,-600,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=600,600,200

SWARM_CBF_RL_MODE=active
SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_10ms_v1.json
SWARM_CBF_RL_MODEL_SHA256=bb61f15e6832a0afad8ee6ded649c3210fbdf521a20a2056742c4c9ef509e1ef
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_sparrow_active_10ms_corridor.jsonl

SWARM_TRAJECTORY_UAV_01_KIND=linear
SWARM_TRAJECTORY_UAV_01_START_ENU_M=0,0,30
SWARM_TRAJECTORY_UAV_01_END_ENU_M=300,0,30
SWARM_TRAJECTORY_UAV_01_SPEED_M_S=10
SWARM_TRAJECTORY_UAV_02_KIND=linear
SWARM_TRAJECTORY_UAV_02_START_ENU_M=300,0,30
SWARM_TRAJECTORY_UAV_02_END_ENU_M=0,0,30
SWARM_TRAJECTORY_UAV_02_SPEED_M_S=10
