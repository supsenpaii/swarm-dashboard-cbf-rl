<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Swarm UAV Dashboard</title>

    <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    >

    <style>
        :root {
            --background: #0f172a;
            --header: #111827;
            --panel: #1e293b;
            --panel-dark: #172033;
            --panel-darker: #0f172a;
            --border: #334155;
            --border-light: #475569;
            --text: #e2e8f0;
            --text-muted: #94a3b8;
            --primary: #2563eb;
            --primary-light: #60a5fa;
            --green: #15803d;
            --orange: #c2410c;
            --red: #b91c1c;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: var(--background);
            color: var(--text);
        }

        button,
        input {
            font: inherit;
        }

        header {
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 24px;
            background: var(--header);
            border-bottom: 1px solid var(--border);
        }

        header h1 {
            margin: 0;
            font-size: 21px;
        }

        #connection-status {
            padding: 8px 14px;
            border-radius: 18px;
            background: #7f1d1d;
            font-size: 14px;
        }

        #connection-status.connected {
            background: #166534;
        }

        main {
            display: grid;
            grid-template-columns: 430px 1fr;
            height: calc(100vh - 64px);
        }

        #sidebar {
            overflow-y: auto;
            padding: 16px;
            border-right: 1px solid var(--border);
            scrollbar-width: thin;
            scrollbar-color: #475569 transparent;
        }

        #map {
            width: 100%;
            height: 100%;
        }

        .summary {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .summary-box {
            padding: 13px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--panel);
        }

        .summary-label,
        .telemetry-label {
            color: var(--text-muted);
            font-size: 12px;
        }

        .summary-value {
            margin-top: 4px;
            font-size: 22px;
            font-weight: bold;
        }

        .uav-tabs {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }

        .uav-tab {
            min-height: 46px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: var(--panel);
            color: var(--text-muted);
            font-weight: bold;
            cursor: pointer;
            transition:
                background 0.18s ease,
                border-color 0.18s ease,
                color 0.18s ease,
                transform 0.18s ease;
        }

        .uav-tab:hover {
            color: #ffffff;
            border-color: var(--primary-light);
            transform: translateY(-1px);
        }

        .uav-tab.active {
            background: var(--primary);
            border-color: var(--primary-light);
            color: white;
            box-shadow: 0 5px 14px rgba(37, 99, 235, 0.25);
        }

        .tab-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            margin-left: 7px;
            border-radius: 50%;
            background: #ef4444;
        }

        .tab-dot.online {
            background: #22c55e;
            box-shadow: 0 0 7px rgba(34, 197, 94, 0.7);
        }

        .drone-card {
            padding: 14px;
            margin-bottom: 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: var(--panel);
        }

        .drone-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .drone-name {
            font-size: 18px;
            font-weight: bold;
        }

        .badge {
            padding: 5px 10px;
            border-radius: 13px;
            font-size: 12px;
        }

        .badge.online {
            background: #166534;
        }

        .badge.offline {
            background: #7f1d1d;
        }

        .telemetry-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px 12px;
        }

        .telemetry-item {
            min-width: 0;
            padding: 7px 0;
            border-bottom: 1px solid var(--border);
        }

        .telemetry-value {
            margin-top: 3px;
            font-size: 14px;
            font-weight: bold;
            overflow-wrap: anywhere;
        }

        .alerts {
            margin-top: 12px;
            padding: 10px;
            border-radius: 8px;
            background: #422006;
            color: #fde68a;
            font-size: 13px;
        }

        .control-panel {
            padding: 16px;
            margin-bottom: 14px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: var(--panel);
            box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
        }

        .control-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .control-title {
            color: #f8fafc;
            font-size: 18px;
            font-weight: 700;
        }

        .control-subtitle {
            margin-top: 4px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .control-subtitle strong {
            color: var(--primary-light);
        }

        .control-status {
            min-width: 54px;
            padding: 7px 12px;
            border: 1px solid #991b1b;
            border-radius: 20px;
            background: rgba(127, 29, 29, 0.75);
            color: #fecaca;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
        }

        .control-status.enabled {
            border-color: var(--green);
            background: rgba(22, 101, 52, 0.85);
            color: #dcfce7;
        }

        .main-control-buttons {
            display: grid;
            grid-template-columns: 1.35fr 0.65fr;
            gap: 10px;
        }

        .control-button,
        .flight-button {
            min-height: 44px;
            border: 0;
            border-radius: 9px;
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition:
                transform 0.15s ease,
                filter 0.15s ease,
                box-shadow 0.15s ease;
        }

        .control-button:hover,
        .flight-button:hover {
            filter: brightness(1.12);
            transform: translateY(-1px);
        }

        .control-button:active,
        .flight-button:active {
            transform: translateY(1px);
        }

        .enable-button {
            background: var(--primary);
            box-shadow: 0 5px 14px rgba(37, 99, 235, 0.24);
        }

        .stop-button {
            background: #dc2626;
            box-shadow: 0 5px 14px rgba(220, 38, 38, 0.22);
        }

        .panel-section {
            padding-top: 14px;
            margin-top: 14px;
            border-top: 1px solid var(--border);
        }

        .section-title {
            margin-bottom: 10px;
            color: var(--text-muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .flight-action-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .arm-button {
            background: var(--green);
        }

        .land-button {
            background: var(--orange);
        }

        .disarm-button {
            background: #991b1b;
        }

        .keyboard-control-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.95fr;
            gap: 10px;
        }

        .movement-control-card,
        .secondary-control-card {
            padding: 11px;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: var(--panel-dark);
        }

        .key-group-title {
            margin-bottom: 10px;
            color: #cbd5e1;
            font-size: 12px;
            font-weight: 700;
            text-align: center;
        }

        .movement-pad {
            display: grid;
            grid-template-columns: repeat(3, minmax(54px, 1fr));
            gap: 7px;
        }

        .secondary-controls {
            display: grid;
            grid-template-rows: 1fr 1fr;
            gap: 10px;
        }

        .dual-key-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 7px;
        }

        .key {
            min-height: 55px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            border: 1px solid var(--border-light);
            border-bottom-width: 3px;
            border-radius: 8px;
            background: var(--panel-darker);
            color: #f8fafc;
            font-size: 18px;
            font-weight: 700;
            user-select: none;
            transition:
                background 0.12s ease,
                border-color 0.12s ease,
                transform 0.12s ease,
                box-shadow 0.12s ease;
        }

        .key span {
            color: var(--text-muted);
            font-size: 9px;
            font-weight: 500;
            text-transform: uppercase;
        }

        .key.active {
            border-color: var(--primary-light);
            background: var(--primary);
            transform: translateY(2px);
            box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
        }

        .key.active span {
            color: #dbeafe;
        }

        .compact-key {
            min-height: 49px;
            font-size: 16px;
        }

        .space-help {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 11px;
            color: var(--text-muted);
            font-size: 11px;
        }

        .space-key {
            padding: 5px 18px;
            border: 1px solid var(--border-light);
            border-bottom-width: 3px;
            border-radius: 6px;
            background: var(--panel-darker);
            color: var(--text);
            font-size: 10px;
            font-weight: 700;
        }

        .slider-card {
            padding: 11px 12px;
            margin-bottom: 8px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: var(--panel-dark);
        }

        .slider-card:last-child {
            margin-bottom: 0;
        }

        .slider-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 9px;
            color: #cbd5e1;
            font-size: 12px;
        }

        .slider-header strong {
            color: var(--primary-light);
            font-size: 12px;
        }

        .slider-card input[type="range"] {
            width: 100%;
            height: 5px;
            appearance: none;
            border-radius: 5px;
            background: var(--border-light);
            cursor: pointer;
        }

        .slider-card input[type="range"]::-webkit-slider-thumb {
            width: 18px;
            height: 18px;
            appearance: none;
            border: 2px solid #ffffff;
            border-radius: 50%;
            background: #3b82f6;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
        }

        .slider-card input[type="range"]::-moz-range-thumb {
            width: 16px;
            height: 16px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            background: #3b82f6;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.4);
        }

        @media (max-width: 900px) {
            main {
                grid-template-columns: 1fr;
                grid-template-rows: 55% 45%;
            }

            #map {
                order: 1;
            }

            #sidebar {
                order: 2;
                border-right: 0;
                border-top: 1px solid var(--border);
            }
        }

        @media (max-width: 480px) {
            header {
                padding: 0 12px;
            }

            header h1 {
                font-size: 17px;
            }

            .keyboard-control-grid {
                grid-template-columns: 1fr;
            }

            .secondary-controls {
                grid-template-columns: 1fr 1fr;
                grid-template-rows: auto;
            }

            .flight-action-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>
<header>
    <h1>Swarm UAV Dashboard</h1>

    <div id="connection-status">
        WebSocket disconnected
    </div>
</header>

<main>
    <section id="sidebar">
        <div class="summary">
            <div class="summary-box">
                <div class="summary-label">
                    Total UAV
                </div>

                <div
                    class="summary-value"
                    id="total-count"
                >
                    0
                </div>
            </div>

            <div class="summary-box">
                <div class="summary-label">
                    Online
                </div>

                <div
                    class="summary-value"
                    id="online-count"
                >
                    0
                </div>
            </div>
        </div>

        <div class="uav-tabs">
            <button
                type="button"
                class="uav-tab active"
                data-drone-id="UAV-01"
            >
                UAV-01

                <span
                    id="tab-dot-UAV-01"
                    class="tab-dot"
                ></span>
            </button>

            <button
                type="button"
                class="uav-tab"
                data-drone-id="UAV-02"
            >
                UAV-02

                <span
                    id="tab-dot-UAV-02"
                    class="tab-dot"
                ></span>
            </button>
        </div>

        <div id="drone-list">
            Waiting for telemetry...
        </div>

        <div class="control-panel">
            <div class="control-header">
                <div>
                    <div class="control-title">
                        Keyboard Control
                    </div>

                    <div class="control-subtitle">
                        Active vehicle:
                        <strong id="control-target">
                            UAV-01
                        </strong>
                    </div>
                </div>

                <div
                    id="control-status"
                    class="control-status"
                >
                    OFF
                </div>
            </div>

            <div class="main-control-buttons">
                <button
                    id="toggle-control"
                    type="button"
                    class="control-button enable-button"
                >
                    Enable keyboard
                </button>

                <button
                    id="stop-button"
                    type="button"
                    class="control-button stop-button"
                >
                    STOP
                </button>
            </div>

            <div class="panel-section">
                <div class="section-title">
                    Flight Actions
                </div>

                <div class="flight-action-grid">
                    <button
                        id="arm-button"
                        type="button"
                        class="flight-button arm-button"
                    >
                        ARM
                    </button>

                    <button
                        id="land-button"
                        type="button"
                        class="flight-button land-button"
                    >
                        LAND
                    </button>

                    <button
                        id="disarm-button"
                        type="button"
                        class="flight-button disarm-button"
                    >
                        DISARM
                    </button>
                </div>
            </div>

            <div class="panel-section">
                <div class="section-title">
                    Movement Controls
                </div>

                <div class="keyboard-control-grid">
                    <div class="movement-control-card">
                        <div class="key-group-title">
                            Movement
                        </div>

                        <div class="movement-pad">
                            <div></div>

                            <div
                                class="key"
                                data-key="w"
                            >
                                W
                                <span>Forward</span>
                            </div>

                            <div></div>

                            <div
                                class="key"
                                data-key="a"
                            >
                                A
                                <span>Left</span>
                            </div>

                            <div
                                class="key"
                                data-key="s"
                            >
                                S
                                <span>Back</span>
                            </div>

                            <div
                                class="key"
                                data-key="d"
                            >
                                D
                                <span>Right</span>
                            </div>
                        </div>
                    </div>

                    <div class="secondary-controls">
                        <div class="secondary-control-card">
                            <div class="key-group-title">
                                Yaw
                            </div>

                            <div class="dual-key-row">
                                <div
                                    class="key compact-key"
                                    data-key="q"
                                >
                                    Q
                                    <span>Left</span>
                                </div>

                                <div
                                    class="key compact-key"
                                    data-key="e"
                                >
                                    E
                                    <span>Right</span>
                                </div>
                            </div>
                        </div>

                        <div class="secondary-control-card">
                            <div class="key-group-title">
                                Altitude
                            </div>

                            <div class="dual-key-row">
                                <div
                                    class="key compact-key"
                                    data-key="r"
                                >
                                    R
                                    <span>Up</span>
                                </div>

                                <div
                                    class="key compact-key"
                                    data-key="f"
                                >
                                    F
                                    <span>Down</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="space-help">
                    <div class="space-key">
                        SPACE
                    </div>

                    <span>
                        Dừng chuyển động ngay lập tức
                    </span>
                </div>
            </div>

            <div class="panel-section">
                <div class="section-title">
                    Control Sensitivity
                </div>

                <div class="slider-card">
                    <div class="slider-header">
                        <span>
                            Horizontal speed
                        </span>

                        <strong id="speed-value">
                            1.0 m/s
                        </strong>
                    </div>

                    <input
                        id="speed-slider"
                        type="range"
                        min="0.2"
                        max="3.0"
                        step="0.1"
                        value="1.0"
                    >
                </div>

                <div class="slider-card">
                    <div class="slider-header">
                        <span>
                            Vertical speed
                        </span>

                        <strong id="vertical-value">
                            0.7 m/s
                        </strong>
                    </div>

                    <input
                        id="vertical-slider"
                        type="range"
                        min="0.2"
                        max="2.0"
                        step="0.1"
                        value="0.7"
                    >
                </div>

                <div class="slider-card">
                    <div class="slider-header">
                        <span>
                            Yaw rate
                        </span>

                        <strong id="yaw-value">
                            45 °/s
                        </strong>
                    </div>

                    <input
                        id="yaw-slider"
                        type="range"
                        min="10"
                        max="120"
                        step="5"
                        value="45"
                    >
                </div>
            </div>
        </div>
    </section>

    <section id="map"></section>
</main>

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
></script>

<script>
    const ALLOWED_DRONES = [
        "UAV-01",
        "UAV-02"
    ];

    const NAV_STATE_NAMES = {
        0: "Manual mode",
        1: "Altitude mode",
        2: "Position mode",
        3: "Mission mode",
        4: "Hold / Loiter mode",
        5: "Return to Launch",
        6: "Position Slow mode",
        10: "Acro mode",
        12: "Descend mode",
        13: "Termination",
        14: "Offboard mode",
        15: "Stabilized mode",
        17: "Takeoff mode",
        18: "Land mode",
        19: "Follow Target",
        20: "Precision Land",
        21: "Orbit mode",
        22: "VTOL Takeoff"
    };

    const map = L.map("map").setView(
        [47.3979712, 8.5461637],
        18
    );

    L.tileLayer(
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            maxZoom: 20,
            attribution:
                "© OpenStreetMap contributors"
        }
    ).addTo(map);

    const markers = {};
    const trails = {};

    let socket = null;
    let selectedDroneId = "UAV-01";
    let latestDrones = {};
    let firstPositionReceived = false;

    const pressedKeys = new Set();

    const keyboardEnabled = {
        "UAV-01": false,
        "UAV-02": false
    };

    const connectionStatus =
        document.getElementById(
            "connection-status"
        );

    const droneList =
        document.getElementById(
            "drone-list"
        );

    const totalCount =
        document.getElementById(
            "total-count"
        );

    const onlineCount =
        document.getElementById(
            "online-count"
        );

    const controlTarget =
        document.getElementById(
            "control-target"
        );

    const controlStatus =
        document.getElementById(
            "control-status"
        );

    const toggleControlButton =
        document.getElementById(
            "toggle-control"
        );

    const speedSlider =
        document.getElementById(
            "speed-slider"
        );

    const verticalSlider =
        document.getElementById(
            "vertical-slider"
        );

    const yawSlider =
        document.getElementById(
            "yaw-slider"
        );

    function valueOrNA(
        value,
        digits = null
    ) {
        if (
            value === null ||
            value === undefined ||
            Number.isNaN(Number(value))
        ) {
            return "N/A";
        }

        if (digits !== null) {
            return Number(value).toFixed(
                digits
            );
        }

        return value;
    }

    function navStateName(navState) {
        if (
            navState === null ||
            navState === undefined
        ) {
            return "N/A";
        }

        return (
            NAV_STATE_NAMES[
                Number(navState)
            ]
            ?? `Unknown (${navState})`
        );
    }

    function collectWarnings(drone) {
        const warnings = [];
        const flags =
            drone.failsafe_flags || {};
        const status =
            drone.status || {};

        if (status.failsafe) {
            warnings.push(
                "PX4 failsafe active"
            );
        }

        if (
            flags.manual_control_signal_lost
        ) {
            warnings.push(
                "Manual control signal lost"
            );
        }

        if (flags.gcs_connection_lost) {
            warnings.push(
                "GCS connection lost"
            );
        }

        if (
            flags.offboard_control_signal_lost
        ) {
            warnings.push(
                "Offboard signal unavailable"
            );
        }

        return warnings;
    }

    function renderDroneCard(
        droneId,
        drone
    ) {
        const status =
            drone.status || {};

        const battery =
            drone.battery || {};

        const gps =
            drone.gps || {};

        const position =
            drone.global_position || {};

        const local =
            drone.local_position || {};

        const attitude =
            drone.attitude || {};

        const warnings =
            collectWarnings(drone);

        return `
            <div class="drone-card">
                <div class="drone-header">
                    <div class="drone-name">
                        ${droneId}
                    </div>

                    <div class="badge ${
                        drone.online
                        ? "online"
                        : "offline"
                    }">
                        ${
                            drone.online
                            ? "ONLINE"
                            : "OFFLINE"
                        }
                    </div>
                </div>

                <div class="telemetry-grid">
                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            System ID
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                drone.system_id
                            )}
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Armed
                        </div>

                        <div class="telemetry-value">
                            ${
                                status.armed
                                ? "YES"
                                : "NO"
                            }
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Nav state
                        </div>

                        <div class="telemetry-value">
                            ${navStateName(
                                status.nav_state
                            )}
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Failsafe
                        </div>

                        <div class="telemetry-value">
                            ${
                                status.failsafe
                                ? "ACTIVE"
                                : "NORMAL"
                            }
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Battery
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                battery.remaining_percent,
                                1
                            )} %
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Voltage
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                battery.voltage_v,
                                2
                            )} V
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            GPS
                        </div>

                        <div class="telemetry-value">
                            Fix ${valueOrNA(
                                gps.fix_type
                            )}
                            · ${valueOrNA(
                                gps.satellites_used
                            )} sats
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Altitude
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                position.altitude_msl_m,
                                2
                            )} m
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Local XYZ
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                local.x_north_m,
                                1
                            )},
                            ${valueOrNA(
                                local.y_east_m,
                                1
                            )},
                            ${valueOrNA(
                                local.z_down_m,
                                1
                            )}
                        </div>
                    </div>

                    <div class="telemetry-item">
                        <div class="telemetry-label">
                            Roll/Pitch/Yaw
                        </div>

                        <div class="telemetry-value">
                            ${valueOrNA(
                                attitude.roll_deg,
                                1
                            )}° /
                            ${valueOrNA(
                                attitude.pitch_deg,
                                1
                            )}° /
                            ${valueOrNA(
                                attitude.yaw_deg,
                                1
                            )}°
                        </div>
                    </div>
                </div>

                ${
                    warnings.length > 0
                    ? `
                        <div class="alerts">
                            ${warnings.join("<br>")}
                        </div>
                    `
                    : ""
                }
            </div>
        `;
    }

    function renderSelectedDrone() {
        const drone =
            latestDrones[selectedDroneId];

        if (!drone) {
            droneList.textContent =
                `Waiting for ${selectedDroneId} telemetry...`;

            return;
        }

        droneList.innerHTML =
            renderDroneCard(
                selectedDroneId,
                drone
            );
    }

    function updateMap(
        droneId,
        drone
    ) {
        const position =
            drone.global_position || {};

        const lat =
            position.latitude_deg;

        const lon =
            position.longitude_deg;

        if (
            typeof lat !== "number" ||
            typeof lon !== "number"
        ) {
            return;
        }

        const point = [
            lat,
            lon
        ];

        if (!markers[droneId]) {
            markers[droneId] =
                L.circleMarker(
                    point,
                    {
                        radius: 9,
                        weight: 3,
                        fillOpacity: 0.85
                    }
                ).addTo(map);

            markers[droneId].on(
                "click",
                () => selectDroneTab(
                    droneId
                )
            );

            trails[droneId] =
                L.polyline(
                    [],
                    {
                        weight: 3
                    }
                ).addTo(map);
        }

        markers[droneId].setLatLng(
            point
        );

        markers[droneId].setPopupContent(
            `<strong>${droneId}</strong><br>` +
            `Mode: ${navStateName(
                drone.status?.nav_state
            )}<br>` +
            `Altitude: ${valueOrNA(
                position.altitude_msl_m,
                2
            )} m`
        );

        const points =
            trails[droneId]
                .getLatLngs();

        if (
            points.length === 0 ||
            map.distance(
                points[points.length - 1],
                L.latLng(lat, lon)
            ) > 0.15
        ) {
            trails[droneId].addLatLng(
                point
            );
        }

        if (!firstPositionReceived) {
            map.setView(
                point,
                18
            );

            firstPositionReceived = true;
        }
    }

    function renderDrones(drones) {
        latestDrones =
            drones || {};

        const entries =
            Object.entries(latestDrones)
                .filter(
                    ([droneId]) =>
                        ALLOWED_DRONES.includes(
                            droneId
                        )
                );

        totalCount.textContent =
            entries.length;

        onlineCount.textContent =
            entries.filter(
                ([, drone]) =>
                    Boolean(drone.online)
            ).length;

        entries.forEach(
            ([droneId, drone]) => {
                updateMap(
                    droneId,
                    drone
                );

                document
                    .getElementById(
                        `tab-dot-${droneId}`
                    )
                    ?.classList.toggle(
                        "online",
                        Boolean(drone.online)
                    );
            }
        );

        renderSelectedDrone();
    }

    function sendJson(payload) {
        if (
            !socket ||
            socket.readyState !== WebSocket.OPEN
        ) {
            return false;
        }

        socket.send(
            JSON.stringify(payload)
        );

        return true;
    }

    function sendAction(
        action,
        droneId = selectedDroneId
    ) {
        sendJson(
            {
                type: "control_action",
                drone_id: droneId,
                action
            }
        );
    }

    function sendZero(droneId) {
        sendJson(
            {
                type: "control_velocity",
                drone_id: droneId,
                forward_m_s: 0,
                right_m_s: 0,
                up_m_s: 0,
                yaw_rate_rad_s: 0
            }
        );
    }

    function currentCommand() {
        let forward =
            (
                pressedKeys.has("w")
                ? 1
                : 0
            )
            -
            (
                pressedKeys.has("s")
                ? 1
                : 0
            );

        let right =
            (
                pressedKeys.has("d")
                ? 1
                : 0
            )
            -
            (
                pressedKeys.has("a")
                ? 1
                : 0
            );

        const magnitude =
            Math.hypot(
                forward,
                right
            );

        if (magnitude > 1) {
            forward /= magnitude;
            right /= magnitude;
        }

        const up =
            (
                pressedKeys.has("r")
                ? 1
                : 0
            )
            -
            (
                pressedKeys.has("f")
                ? 1
                : 0
            );

        const yaw =
            (
                pressedKeys.has("e")
                ? 1
                : 0
            )
            -
            (
                pressedKeys.has("q")
                ? 1
                : 0
            );

        const speed =
            Number(
                speedSlider.value
            );

        const verticalSpeed =
            Number(
                verticalSlider.value
            );

        const yawRate =
            Number(
                yawSlider.value
            )
            * Math.PI
            / 180;

        return {
            forward_m_s:
                forward * speed,
            right_m_s:
                right * speed,
            up_m_s:
                up * verticalSpeed,
            yaw_rate_rad_s:
                yaw * yawRate
        };
    }

    function sendCurrentCommand() {
        if (
            !keyboardEnabled[
                selectedDroneId
            ]
        ) {
            return;
        }

        sendJson(
            {
                type: "control_velocity",
                drone_id: selectedDroneId,
                ...currentCommand()
            }
        );
    }

    function updateControlUi() {
        const enabled =
            keyboardEnabled[
                selectedDroneId
            ];

        controlTarget.textContent =
            selectedDroneId;

        controlStatus.textContent =
            enabled
            ? "ON"
            : "OFF";

        controlStatus.classList.toggle(
            "enabled",
            enabled
        );

        toggleControlButton.textContent =
            enabled
            ? "Disable keyboard"
            : "Enable keyboard";
    }

    function clearKeysAndStop(
        droneId
    ) {
        pressedKeys.clear();

        document
            .querySelectorAll(".key")
            .forEach(element => {
                element.classList.remove(
                    "active"
                );
            });

        sendZero(droneId);
    }

    function selectDroneTab(
        droneId
    ) {
        if (
            droneId === selectedDroneId
        ) {
            return;
        }

        const previousDrone =
            selectedDroneId;

        clearKeysAndStop(
            previousDrone
        );

        selectedDroneId =
            droneId;

        document
            .querySelectorAll(
                ".uav-tab"
            )
            .forEach(button => {
                button.classList.toggle(
                    "active",
                    button.dataset.droneId
                    === droneId
                );
            });

        updateControlUi();
        renderSelectedDrone();
    }

    document
        .querySelectorAll(".uav-tab")
        .forEach(button => {
            button.addEventListener(
                "click",
                () => {
                    selectDroneTab(
                        button.dataset.droneId
                    );
                }
            );
        });

    toggleControlButton.addEventListener(
        "click",
        () => {
            const enabled =
                !keyboardEnabled[
                    selectedDroneId
                ];

            keyboardEnabled[
                selectedDroneId
            ] = enabled;

            if (enabled) {
                sendAction(
                    "enable_offboard"
                );
            } else {
                clearKeysAndStop(
                    selectedDroneId
                );

                sendAction(
                    "keyboard_off"
                );
            }

            updateControlUi();
        }
    );

    document
        .getElementById(
            "stop-button"
        )
        .addEventListener(
            "click",
            () => {
                clearKeysAndStop(
                    selectedDroneId
                );

                sendAction(
                    "stop"
                );
            }
        );

    document
        .getElementById(
            "arm-button"
        )
        .addEventListener(
            "click",
            () => {
                sendAction(
                    "arm"
                );
            }
        );

    document
        .getElementById(
            "disarm-button"
        )
        .addEventListener(
            "click",
            () => {
                if (
                    window.confirm(
                        `Disarm ${selectedDroneId}?`
                    )
                ) {
                    sendAction(
                        "disarm"
                    );
                }
            }
        );

    document
        .getElementById(
            "land-button"
        )
        .addEventListener(
            "click",
            () => {
                clearKeysAndStop(
                    selectedDroneId
                );

                sendAction(
                    "land"
                );
            }
        );

    const controlledKeys =
        new Set([
            "w",
            "a",
            "s",
            "d",
            "q",
            "e",
            "r",
            "f",
            " "
        ]);

    window.addEventListener(
        "keydown",
        event => {
            const key =
                event.key.toLowerCase();

            if (
                !controlledKeys.has(key)
            ) {
                return;
            }

            if (
                event.target
                instanceof HTMLInputElement
            ) {
                return;
            }

            event.preventDefault();

            if (
                !keyboardEnabled[
                    selectedDroneId
                ]
            ) {
                return;
            }

            if (key === " ") {
                clearKeysAndStop(
                    selectedDroneId
                );

                return;
            }

            pressedKeys.add(key);

            document
                .querySelector(
                    `.key[data-key="${key}"]`
                )
                ?.classList.add(
                    "active"
                );

            sendCurrentCommand();
        }
    );

    window.addEventListener(
        "keyup",
        event => {
            const key =
                event.key.toLowerCase();

            if (
                !controlledKeys.has(key)
            ) {
                return;
            }

            event.preventDefault();

            pressedKeys.delete(key);

            document
                .querySelector(
                    `.key[data-key="${key}"]`
                )
                ?.classList.remove(
                    "active"
                );

            sendCurrentCommand();
        }
    );

    window.addEventListener(
        "blur",
        () => {
            clearKeysAndStop(
                selectedDroneId
            );
        }
    );

    document.addEventListener(
        "visibilitychange",
        () => {
            if (document.hidden) {
                clearKeysAndStop(
                    selectedDroneId
                );
            }
        }
    );

    speedSlider.addEventListener(
        "input",
        () => {
            document
                .getElementById(
                    "speed-value"
                )
                .textContent =
                `${speedSlider.value} m/s`;
        }
    );

    verticalSlider.addEventListener(
        "input",
        () => {
            document
                .getElementById(
                    "vertical-value"
                )
                .textContent =
                `${verticalSlider.value} m/s`;
        }
    );

    yawSlider.addEventListener(
        "input",
        () => {
            document
                .getElementById(
                    "yaw-value"
                )
                .textContent =
                `${yawSlider.value} °/s`;
        }
    );

    setInterval(
        sendCurrentCommand,
        100
    );

    function connectWebSocket() {
        const protocol =
            window.location.protocol
            === "https:"
            ? "wss"
            : "ws";

        socket = new WebSocket(
            `${protocol}://${window.location.host}/ws`
        );

        socket.onopen = () => {
            connectionStatus.textContent =
                "WebSocket connected";

            connectionStatus
                .classList.add(
                    "connected"
                );
        };

        socket.onmessage = event => {
            try {
                const message =
                    JSON.parse(
                        event.data
                    );

                if (
                    message.type
                    ===
                    "telemetry_snapshot"
                ) {
                    renderDrones(
                        message.drones
                    );
                }
            } catch (error) {
                console.error(
                    error
                );
            }
        };

        socket.onclose = () => {
            connectionStatus.textContent =
                "WebSocket disconnected";

            connectionStatus
                .classList.remove(
                    "connected"
                );

            ALLOWED_DRONES.forEach(
                droneId => {
                    keyboardEnabled[
                        droneId
                    ] = false;
                }
            );

            clearKeysAndStop(
                selectedDroneId
            );

            updateControlUi();

            setTimeout(
                connectWebSocket,
                2000
            );
        };

        socket.onerror = () => {
            socket.close();
        };
    }

    updateControlUi();
    connectWebSocket();
</script>
</body>
</html>
