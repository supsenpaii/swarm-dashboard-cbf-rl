# Local environment — contains machine-specific paths and the resolved ENU
# origin. Use .env.example as the tracked template.
.env

# Virtualenv and caches
.venv/
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
install/
log/

# Run outputs: capture corpora, model training runs, SITL/CBF gate JSON.
# Large (tens of GB) and regenerable from the harnesses.
artifacts/
build/
logs/
*.log

# Trained model binaries and third-party weights stay local. The native
# Sparrow plant is source input, so keep only those model directories tracked.
models/*
!models/models/
models/models/*
!models/models/SPARROW_TUNING_TUNG_BUOC.md
!models/models/sparrow_base/
!models/models/sparrow/
!models/models/sparrow_gimbal_core/
!models/models/sparrow_gimbal/

# Distribution snapshots taken by hand
handoff/
swarm_dashboard_handoff_*/
*.tar.gz
*.zip
*.backup*
*.before_*
*_TMP.*

# Editor / tooling state
.codegraph/
.claude/
.idea/
.vscode/
*.code-workspace
*.swp

# Design canvas: nguồn .dc.html được giữ, bản đóng gói 2 MB thì không.
design/*.html
!design/*.dc.html

# Map tile pack — rebuild with fetch_map_tiles.py
static/tiles/

# Khoá riêng iroh của shadow transport — sinh lại được, không bao giờ đẩy đi.
keys/
