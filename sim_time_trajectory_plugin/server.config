<!--
  Not actually used by the sim_time_plugin trajectory driver: gz-sim only
  falls back to GZ_SIM_SERVER_CONFIG_PATH for worlds that declare no system
  plugins of their own, and PX4's default.sdf already declares its own.
  The plugin is instead injected directly into a world SDF overlay by
  build_overlay_world.py. Kept here only as a record of the earlier
  (non-working) approach.
-->
<server_config>
  <plugins>
    <plugin entity_name="*"
            entity_type="world"
            filename="libswarm_sim_time_trajectory.so"
            name="swarm::simulation::SimTimeTrajectorySystem"/>
  </plugins>
</server_config>
