# Sparrow ACTIVE trajectory tracking on a 240 m square at 15 m/s.
#
# One question only: how tightly does the aircraft hold a drawn path, corners
# included. There is no conflict here on purpose -- UAV-02 sits 700 m away on
# a 10 m leg of its own, far outside any separation the barrier asks for, so
# nothing the CBF or the coordinator does can contaminate the cross-track.
#
# The offline replay of this exact geometry (test_sparrow_corridor_replay.py,
# 240 m square, 15 m/s, tau 0.860 s) predicts 0.323 m worst cross-track, a
# corner passed at 0.655 m/s, and full 15 m/s cruise on the straights. This
# profile exists to find out where that prediction is wrong against a real
# plant -- the corner logic has never flown.
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=false

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=700,0,0,0,0,0
# PX4 clamps horizontal speed at MPC_XY_VEL_MAX, default 10 on this airframe.
# Without this the vehicle flies the shape but never the speed, and the
# cross-track metric cannot see the difference: it measures distance to the
# nearest point on the path, so falling behind the reference reads as zero.
SWARM_PX4_MPC_XY_VEL_MAX=15.0
SWARM_FORMATION_MAXIMUM_VELOCITY_M_S=15
SWARM_FORMATION_SLOT_UAV_02_ENU_M=700,0,0

SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=15
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-900,-900,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=900,900,200

SWARM_CBF_RL_MODE=active
SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_15ms_v1.json
SWARM_CBF_RL_MODEL_SHA256=c90cdb35312f6d7e68cb536fd82364a908c03755dd6ea8648ff3fff8d8fd150c
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_sparrow_polygon_15ms.jsonl

SWARM_TRAJECTORY_UAV_01_KIND=polyline
SWARM_TRAJECTORY_UAV_01_WAYPOINTS_ENU_M=0,0,10:240,0,10:240,240,10:0,240,10
# 14.76, not 15: Sparrow's measured steady-state velocity gain is 1.016 at
# cruise (299 settled samples, 2026-08-16 polygon flight; the response-ID
# flight read 1.090 on a step). The certified ceiling is the speed the
# aircraft REACHES -- the offline plant converges exactly onto its command,
# gain 1.0 -- so commanding 15.00 flies 15.24 and tests a contract 3% harsher
# than the one the barrier was sized for. The flight guard catching that at
# 15.51 was correct.
SWARM_TRAJECTORY_UAV_01_SPEED_M_S=14.76
SWARM_TRAJECTORY_UAV_02_KIND=linear
SWARM_TRAJECTORY_UAV_02_START_ENU_M=700,0,10
SWARM_TRAJECTORY_UAV_02_END_ENU_M=710,0,10
SWARM_TRAJECTORY_UAV_02_SPEED_M_S=1

# Takeoff costs ~35 s for the pair before the hold even starts, so the
# default 120 s envelope cannot contain a 120 s hold -- the 20 m/s rung died
# on maximum_test_duration_exceeded at t=120.4 having flown 79 s of it. This
# belongs in the profile rather than the operator's shell, which is exactly
# how it went missing between two runs of the same rung.
SWARM_FIRST_FLIGHT_MAX_DURATION_S=300
