# Sparrow crossing missions on the WEB mission path, 20 m/s envelope.
#
# The 10 m/s profile beside this one certified the drawn-mission path at its
# own rung. This asks whether that path holds at the top of the ladder, which
# is what the dashboard slider would be claiming if it were raised to 20.
#
# The geometry roughly doubles, and not for tidiness: a head-on pair at
# 20 m/s reserves 160.4 m of separation against 66.2 at 10, and the
# coordinator engages at 185.4 m against 120. At the 10 m/s profile's 200 m
# spawns that leaves 14.6 m of room before the coordinator is already in the
# encounter. 400 m restores it to 214.6 m. opposite_orbit then reaches
# 1040 m north, which the geofence has to allow.
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=true

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=-371,149,0,0,0,0
SWARM_PX4_MPC_XY_VEL_MAX=20.0
SWARM_FORMATION_MAXIMUM_VELOCITY_M_S=20
SWARM_FORMATION_SLOT_UAV_02_ENU_M=-371,149,0

# The dashboard normally holds the mission at half the CBF ceiling
# (SPEED_FRACTION_OF_CBF_LIMIT). This is the explicit raise that clamp exists
# to require, and the whole point of the profile: fly the mission path at the
# rung's own speed so the ceiling is measured rather than assumed.
SWARM_MISSION_MAXIMUM_VELOCITY_M_S=20
SWARM_MISSION_MAXIMUM_ACCELERATION_M_S2=4.0
SWARM_MISSION_CORNER_TRACKING_TOLERANCE_M=1.0
SWARM_MISSION_RESPONSE_TIME_CONSTANT_S=0.86

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=20
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-800,-800,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=800,1200,200

SWARM_CBF_RL_MODE=active
SWARM_CBF_RL_ACTIVE_ACK=cbf_rl_active_v1
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_20ms_v2.json
SWARM_CBF_RL_MODEL_SHA256=ee958f8f7b4aecf7b2d36d1391e179c73da24fb8b7c6885b398c8fc585f31f2a
# Per scenario, not one shared file: the first run of the four overwrote
# diagonal_cross's evidence with the last scenario's, and diagnosing its
# cbf_invalid_or_infeasible then needed the flight repeated. The runner
# exports SWARM_MISSION_SCENARIO before sourcing this.
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_mission20_${SWARM_MISSION_SCENARIO:-unset}.jsonl

SWARM_FIRST_FLIGHT_MAX_DURATION_S=420
