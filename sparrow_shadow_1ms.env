# Sparrow shadow at 1 m/s -- the first rung of flight evidence for a policy
# that has only ever been certified offline.
#
# The companion flies the pair with the deterministic CBF gate; the CBF-RL
# policy runs alongside in shadow and never touches a transmitted setpoint
# (cbf_rl_shadow applies its output only when mode is "active"). So this
# answers "does the policy load, validate its contract and produce sane
# actions on real telemetry" at zero risk to the aircraft.
#
# Speed contract stays the policy's own 10 m/s -- _validate_active_contract
# pins the two together -- while the flown trajectory is 1 m/s. The ceiling
# and the commanded speed are different things.
SWARM_OFFBOARD_AUTHORITY=companion_safety
SWARM_MISSION_RUNTIME_ENABLED=false

SWARM_UAV_01_MODEL_POSE=0,0,0,0,0,0
SWARM_UAV_02_MODEL_POSE=0,30,0,0,0,0
SWARM_FORMATION_SLOT_UAV_02_ENU_M=0,30,0

SWARM_PEER_STATE_MAX_AGE_MS=100
SWARM_CBF_MINIMUM_SEPARATION_M=20.0
SWARM_CBF_MAXIMUM_VELOCITY_M_S=10.0
SWARM_CBF_BARRIER_GAIN_S_INV=2.0
SWARM_CBF_COMMAND_LATENCY_S=0.86
SWARM_CBF_DESIGN_MARGIN_BUFFER_M=0.0
SWARM_CBF_COVARIANCE_SIGMA=0.1
SWARM_CBF_REQUIRE_POSITION_COVARIANCE=true
SWARM_CBF_RELATIVE_BRAKING_ACCELERATION_M_S2=8.0
SWARM_CBF_TRACKING_RESERVE_M=2.0
SWARM_CBF_GEOFENCE_MIN_ENU_M=-500,-500,0
SWARM_CBF_GEOFENCE_MAX_ENU_M=500,500,200

SWARM_CBF_RL_MODE=shadow
SWARM_CBF_RL_MODEL=${script_dir}/cbf_rl_policy_sparrow_20m_10ms_v1.json
SWARM_CBF_RL_MODEL_SHA256=bb61f15e6832a0afad8ee6ded649c3210fbdf521a20a2056742c4c9ef509e1ef
SWARM_COMPANION_SAFETY_LOG=artifacts/companion_safety_sparrow_shadow_1ms.jsonl

# Parallel legs 30 m apart at 1 m/s: no conflict, so this rung measures the
# stack rather than the avoidance. Conflict geometry comes next.
SWARM_TRAJECTORY_UAV_01_KIND=linear
SWARM_TRAJECTORY_UAV_01_START_ENU_M=0,0,10
SWARM_TRAJECTORY_UAV_01_END_ENU_M=25,0,10
SWARM_TRAJECTORY_UAV_01_SPEED_M_S=1.0
SWARM_TRAJECTORY_UAV_02_KIND=linear
SWARM_TRAJECTORY_UAV_02_START_ENU_M=0,30,10
SWARM_TRAJECTORY_UAV_02_END_ENU_M=25,30,10
SWARM_TRAJECTORY_UAV_02_SPEED_M_S=1.0
